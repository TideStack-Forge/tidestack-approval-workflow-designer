{
  "formatVersion": 2,
  "id": "golden-scenario-3-nested-branch",
  "name": "嵌套分支（外层 XOR + 内层 OR）",
  "formType": "default",
  "formKey": "purchase-form",
  "nodes": [
    { "id": "start-c", "type": "发起节点", "name": "发起" },
    { "id": "approve-e", "type": "审批节点", "name": "直属审批", "subType": "单签", "candidates": [] },
    { "id": "gateway-or-split-c", "type": "GatewayNode", "name": "并发分流", "splitType": "OR" },
    { "id": "approve-f", "type": "审批节点", "name": "财务审批", "subType": "单签", "candidates": [] },
    { "id": "approve-g", "type": "审批节点", "name": "法务审批", "subType": "单签", "candidates": [] },
    { "id": "join-or-c", "type": "JoinNode", "name": "并发汇聚", "joinType": "OR" },
    {
      "id": "notice-c",
      "type": "通知节点",
      "name": "结果通知",
      "notice": { "content": "done", "channel": ["message"], "candidates": [] }
    }
  ],
  "edges": [
    { "id": "e1", "type": "SEQUENCE", "sourceId": "start-c", "targetId": "approve-e", "condition": { "expression": "amount <= 1000" } },
    { "id": "e2", "type": "SEQUENCE", "sourceId": "start-c", "targetId": "gateway-or-split-c", "condition": { "expression": "amount > 1000" } },
    { "id": "e3", "type": "SEQUENCE", "sourceId": "approve-e", "targetId": "notice-c" },
    { "id": "e4", "type": "SEQUENCE", "sourceId": "gateway-or-split-c", "targetId": "approve-f" },
    { "id": "e5", "type": "SEQUENCE", "sourceId": "gateway-or-split-c", "targetId": "approve-g" },
    { "id": "e6", "type": "SEQUENCE", "sourceId": "approve-f", "targetId": "join-or-c" },
    { "id": "e7", "type": "SEQUENCE", "sourceId": "approve-g", "targetId": "join-or-c" },
    { "id": "e8", "type": "SEQUENCE", "sourceId": "join-or-c", "targetId": "notice-c" }
  ]
}
